# MongoDB connection string (Atlas or local). Required.
# Atlas example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/expense-tracker?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign JWT session tokens. Required.
# Generate a strong random value, e.g.: openssl rand -base64 32
JWT_SECRET=

# Runtime environment: development | production | test
NODE_ENV=development
